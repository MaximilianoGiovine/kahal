# TRUSTED_PROXIES: "private_ranges" si hay otro proxy delante (Nginx Proxy Manager, etc.).
# Sin definir, Caddy no confía en los encabezados X-Forwarded-* que recibe.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# SITE_ADDRESS:
#   - ":80"                     -> solo HTTP por IP (pruebas rápidas)
#   - "203-0-113-10.sslip.io"   -> HTTPS automático sin comprar dominio
#   - "app.midominio.com"       -> HTTPS automático con dominio propio
#   - "midominio.com, www.midominio.com" -> además redirige www a la dirección sin www
{$SITE_ADDRESS::80} {
	@www vars_regexp www {host} ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	encode zstd gzip

	request_body {
		max_size 15MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	handle /api/* {
		reverse_proxy api:4000 {
			# La API confía en un solo proxy: recibe directamente la IP real de la persona.
			header_up X-Forwarded-For {client_ip}
			health_uri /api/health
			health_interval 15s
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
		level WARN
	}
}
