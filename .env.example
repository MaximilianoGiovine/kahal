# Copia estas variables en Portainer (Stack > Environment variables).
# Para probar localmente: cp .env.example .env && docker compose up -d --build

# Dirección pública. Sin dominio usa TU-IP con guiones + .sslip.io (ej. 203-0-113-10.sslip.io)
# para tener HTTPS automático. Con ":80" se sirve solo por HTTP.
SITE_ADDRESS=:80

# Secretos (obligatorios). Genéralos con: openssl rand -hex 32
POSTGRES_PASSWORD=cambiar-por-una-clave-segura
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# Super administrador de la plataforma (se crea en el primer arranque)
SUPERADMIN_EMAIL=admin@kahal.app
SUPERADMIN_PASSWORD=cambiar-esta-clave

# Carga 3 iglesias de demostración si la base está vacía
SEED_DEMO=true
# Link de YouTube/Facebook que usarán las transmisiones de demo (ej. el canal de una iglesia real)
DEMO_STREAM_URL=

# Email (opcional). Sin SMTP, los emails solo se registran en el log de la API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kahal <no-reply@tudominio.com>

# Notificaciones push (opcional). Sin estas claves no se ofrecen. Requieren HTTPS.
# Genéralas una sola vez con: npx web-push generate-vapid-keys
# Si las cambias, cada dispositivo tiene que volver a activar las notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Ingreso con Google y Apple (opcional). Sin estas variables, el botón no aparece. Ver README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenido del .p8 en una sola línea, con \n en lugar de los saltos de línea.
APPLE_PRIVATE_KEY=

# Almacenamiento de archivos: "local" (volumen Docker) o "s3" (AWS, Cloudflare R2, etc.)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Suscripciones de las iglesias (opcional). Sin estas variables no se ofrece la pasarela. Ver README.md.
# Dirección pública de la app, con https: a ella vuelve quien paga.
PUBLIC_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=BAAlvQONvL4A77wflT82kamR15oFxWF_qJh6L49zqtN1t902eaPUdoiLcowqI7MeTDgsgCaJRqYPBiFCQ4
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=P-30S80125LY932633YNLW7NKY
PAYPAL_WEBHOOK_ID=
# El id de cliente y el plan son de producción. Para pruebas usa https://api-m.sandbox.paypal.com con los suyos.
PAYPAL_API_URL=https://api-m.paypal.com
