generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Acciones habilitables en un rol. Un usuario sin roles solo accede a lo básico
/// (novedades, eventos, artículos, en vivo y pedir citas).
enum Permission {
  MEMBERS_VIEW
  MEMBERS_EDIT
  MEMBERS_DELETE
  MEMBER_STATUSES_MANAGE
  FINANCE_VIEW
  FINANCE_EDIT
  CONTENT_MANAGE
  ARTICLES_MANAGE
  APPOINTMENTS_HOST
  APPOINTMENTS_ALL
  USERS_VIEW
  USERS_MANAGE
  ROLES_MANAGE
  CHURCH_SETTINGS
  ACTIVITY_VIEW
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

