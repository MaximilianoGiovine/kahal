enum TransactionType {
  INCOME
  EXPENSE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum StreamPlatform {
  YOUTUBE
  FACEBOOK
  TWITCH
  OTHER
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
}

enum ActivityEntity {
  ANNOUNCEMENT
  EVENT
  STREAM
  ARTICLE
}

/// Una iglesia es un tenant: todos los datos operativos cuelgan de ella.
model Church {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Canales de transmisión de la iglesia (links a YouTube, Facebook y Twitch).
  youtubeUrl      String?
  facebookUrl     String?
  twitchUrl       String?
  description     String?
  city            String?
  address         String?
  phone           String?
  email           String?
  logoKey         String?
  primaryColor    String?
  timezone        String   @default("America/Argentina/Buenos_Aires")
  defaultCurrency Currency @default(ARS)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users          User[]
  roles          ChurchRole[]
  members        Member[]
  memberStatuses MemberStatus[]
  families       Family[]
  ministries     Ministry[]
  accounts       FinanceAccount[]
  categories     FinanceCategory[]
  transactions   Transaction[]
  announcements  Announcement[]
  events         Event[]
  streams        LiveStream[]
  availability   Availability[]
  appointments   Appointment[]
  articles       Article[]
  activity       ActivityLog[]
  churchRequests ChurchRequest[]
}

enum ChurchRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pedido público de alta de una iglesia. Un super admin lo revisa y, al aprobarlo, se crea la iglesia con estos datos.
model ChurchRequest {
  id                String              @id @default(cuid())
  status            ChurchRequestStatus @default(PENDING)
  name              String
  slug              String
  city              String?
  message           String?
  timezone          String?
  defaultCurrency   Currency?
  adminFirstName    String
  adminLastName     String
  adminEmail        String
  adminPhone        String
  /// Contraseña elegida por el solicitante, siempre hasheada. Se borra al resolver la solicitud.
  adminPasswordHash String?
  consentAt         DateTime
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Iglesia creada al aprobar.
  churchId          String?
  church            Church?             @relation(fields: [churchId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
}

model User {
  id            String     @id @default(cuid())
  churchId      String?
  church        Church?    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  email         String     @unique
  /// Null en cuentas creadas con Google o Apple que todavía no definieron contraseña.
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  /// Administrador de la plataforma: opera sobre cualquier iglesia con todos los permisos.
  isSuperAdmin  Boolean    @default(false)
  status        UserStatus @default(PENDING)
  /// Incrementar invalida todos los refresh tokens emitidos.
  tokenVersion  Int        @default(0)
  consentAt     DateTime?
  lastLoginAt   DateTime?
  /// Token secreto del feed de calendario personal (.ics). Se crea al pedirlo por primera vez.
  calendarToken String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  identities             UserIdentity[]
  pushSubscriptions      PushSubscription[]
  roles                  UserRole[]
  member                 Member?
  transactions           Transaction[]
  announcements          Announcement[]
  events                 Event[]
  availability           Availability[]
  hostedAppointments     Appointment[]      @relation("AppointmentHost")
  requestedAppointments  Appointment[]      @relation("AppointmentRequester")
  articles               Article[]
  activity               ActivityLog[]
  reviewedChurchRequests ChurchRequest[]

  @@index([churchId, status])
}

enum AuthProvider {
  GOOGLE
  APPLE
}

/// Un dispositivo que aceptó recibir notificaciones push. La URL la asigna el navegador y es única por dispositivo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Cuenta de Google o Apple conectada a un usuario. Se identifica por el "sub" del proveedor, no por el email.
model UserIdentity {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  AuthProvider
  subject   String
  email     String?
  createdAt DateTime     @default(now())

  @@unique([provider, subject])
  @@unique([userId, provider])
}

/// Rol definido por cada iglesia con los permisos que elija.
model ChurchRole {
  id          String       @id @default(cuid())
  churchId    String
  church      Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions Permission[]
  /// Rol de administración: tiene siempre todos los permisos y no se puede eliminar.
  isAdmin     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users UserRole[]

  @@unique([churchId, name])
}

model UserRole {
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       ChurchRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime   @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

/// Persona del padrón de la iglesia. Puede o no tener cuenta de usuario.
model Member {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  documentId  String?
  birthDate   DateTime? @db.Date
  gender      Gender?
  address     String?
  joinedAt    DateTime? @db.Date
  baptismDate DateTime? @db.Date
  /// Si dice estar bautizado/a (null = no informado).
  baptized    Boolean?
  familyId    String?
  family      Family?   @relation(fields: [familyId], references: [id], onDelete: SetNull)
  familyRole  String?
  notes       String?
  photoKey    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statuses      MemberStatusAssignment[]
  ministries    MinistryMember[]
  transactions  Transaction[]
  ledMinistries Ministry[]               @relation("MinistryLeader")

  @@index([churchId, lastName])
}

/// Estado definido por cada iglesia (visitante, bautizado, etc.). Un miembro puede tener varios.
model MemberStatus {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  /// Orden en listas y filtros.
  position    Int      @default(0)
  /// Se asigna automáticamente a quienes crean su cuenta.
  isDefault   Boolean  @default(false)
  /// Quienes lo tienen no cuentan como miembros activos en el inicio.
  inactive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  members MemberStatusAssignment[]

  @@unique([churchId, name])
}

model MemberStatusAssignment {
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  statusId   String
  status     MemberStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([memberId, statusId])
  @@index([statusId])
}

model Family {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  members Member[]

  @@index([churchId])
}

model Ministry {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  leaderId    String?
  leader      Member?  @relation("MinistryLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  members MinistryMember[]

  @@unique([churchId, name])
}

model MinistryMember {
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@id([ministryId, memberId])
}

model FinanceAccount {
  id             String   @id @default(cuid())
  churchId       String
  church         Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name           String
  currency       Currency @default(ARS)
  initialBalance Decimal  @default(0) @db.Decimal(14, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  transactions Transaction[]

  @@unique([churchId, name])
}

model FinanceCategory {
  id       String          @id @default(cuid())
  churchId String
  church   Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name     String
  type     TransactionType
  color    String?
  /// Las categorías de diezmo permiten asociar el movimiento a un miembro.
  isTithe  Boolean         @default(false)
  active   Boolean         @default(true)

  transactions Transaction[]

  @@unique([churchId, name, type])
}

model Transaction {
  id          String          @id @default(cuid())
  churchId    String
  church      Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinanceAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId  String
  category    FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  memberId    String?
  member      Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime        @db.Date
  description String?
  reference   String?
  receiptKey  String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([churchId, date])
  @@index([accountId, date])
  @@index([memberId])
}

model Announcement {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  body        String
  imageKey    String?
  pinned      Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([churchId, publishedAt])
}

model Event {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  imageKey    String?
  isPublic    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([churchId, startsAt])
}

model LiveStream {
  id          String         @id @default(cuid())
  churchId    String
  church      Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String
  platform    StreamPlatform
  scheduledAt DateTime?
  isLive      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([churchId, scheduledAt])
}

/// Franja semanal en la que un pastor/líder recibe citas (hora local de la iglesia).
model Availability {
  id          String @id @default(cuid())
  churchId    String
  church      Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 = domingo ... 6 = sábado
  weekday     Int
  startTime   String
  endTime     String
  slotMinutes Int    @default(30)

  @@index([userId, weekday])
}

model Appointment {
  id             String            @id @default(cuid())
  churchId       String
  church         Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  hostId         String
  host           User              @relation("AppointmentHost", fields: [hostId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User              @relation("AppointmentRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING)
  reason         String?
  hostNotes      String?
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([hostId, startsAt])
  @@index([requesterId, startsAt])
  @@index([churchId, startsAt])
}

/// Artículo de interés escrito por la iglesia. `body` es HTML ya saneado en el servidor.
model Article {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  body        String
  coverKey    String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([churchId, publishedAt])
}

/// Registro de cambios sobre el contenido de la iglesia (quién, qué y cuándo).
model ActivityLog {
  id        String         @id @default(cuid())
  churchId  String
  church    Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    ActivityAction
  entity    ActivityEntity
  entityId  String
  /// Título del elemento al momento del cambio (se conserva aunque luego se borre).
  title     String
  /// Campos modificados, separados por coma.
  detail    String?
  createdAt DateTime       @default(now())

  @@index([churchId, createdAt])
}
